{
  "name": "qa-ci-cd-quality-gates-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "CI/CD quality gates portfolio with unit, API, and UI smoke tests.",
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run tests/unit --reporter=default --reporter=junit --outputFile=reports/unit/junit.xml",
    "test:api": "vitest run tests/api --reporter=default --reporter=junit --outputFile=reports/api/junit.xml",
    "test:ui": "playwright test tests/ui",
    "test": "npm run test:unit && npm run test:api && npm run test:ui"
  },
  "dependencies": {
    "@fastify/static": "^8.1.0",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  },
  "type": "module"
}
